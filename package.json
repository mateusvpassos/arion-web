{
  "name": "mymusic-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:emu": "vite --mode emu --port 4174",
    "icons": "electron desktop/make-icons.cjs",
    "desktop": "vite build && electron .",
    "dist:desktop": "vue-tsc -b && vite build && node desktop/empacotar.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "firebase": "^12.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "description": "MyMusic — cifras e repertórios (web e desktop)",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.mateusvpassos.mymusic",
    "productName": "MyMusic",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/icon.png",
      "desktop/icon.ico",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyMusic",
      "artifactName": "MyMusic-Setup-${version}.${ext}",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "installerHeaderIcon": "desktop/icon.ico"
    }
  }
}
